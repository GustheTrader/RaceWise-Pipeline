# Server-only settings. On Vercel, set these as project environment variables; nothing here reaches the browser.
GEMINI_API_KEY=
# Shared secret for RaceWise AI's pipeline-ingest function (same value as its PIPELINE_INGEST_KEY secret)
PIPELINE_INGEST_KEY=
# Optional override; defaults to the RaceWise AI cloud Supabase project
PIPELINE_INGEST_URL=
# Password the site asks for before it will parse or upload anything
PIPELINE_APP_PASSWORD=
